[Unit]
Description=hl-app single collector and enhancement worker
After=network-online.target postgresql.service hl-app-web.service
Wants=network-online.target

[Service]
Type=simple
User=hlapp
Group=hlapp
WorkingDirectory=/opt/hl-trader
EnvironmentFile=/etc/hl-app/worker.env
ExecStart=/opt/hl-trader/.venv/bin/python -m hl_app.workers --run
Restart=on-failure
RestartSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hl-app
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
