HL_APP_MIGRATION_DATABASE_URL=postgresql://migration-user:secret@host.docker.internal:5432/existing-database
HL_APP_DATABASE_NAME=existing-database
HL_APP_RUNTIME_PASSWORD=replace-with-a-random-url-safe-secret
HL_APP_AUTH_MODE=token
HL_APP_AUTH_TOKEN=replace-with-at-least-32-random-bytes-base64url
HL_APP_CF_TEAM_DOMAIN=
HL_APP_CF_ACCESS_AUD=
HL_APP_SECURE_COOKIE=false
HL_APP_TRUSTED_ORIGINS=http://localhost:28080,http://127.0.0.1:28080
HL_APP_MAX_LEG_NOTIONAL_USD=15000
HL_APP_DATA_ENCRYPTION_KEY_ID=local-v1
HL_APP_RISK_MONITOR_ENABLED=true
HL_APP_RISK_MONITOR_INTERVAL_SECONDS=30
HL_APP_RISK_MAX_DATA_AGE_SECONDS=30
HL_APP_RISK_MONITOR_STALE_SECONDS=60
