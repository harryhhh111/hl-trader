# Worker-only rollout: use a tag pinned to the existing worker image as BASE_IMAGE.
# Keep the installed package and its bundled source consistent; no dependency,
# trading CLI or other application module is rebuilt.
ARG BASE_IMAGE=hl-app-web:local
FROM ${BASE_IMAGE}
COPY --chown=10001:10001 backend/hl_app/workers/__init__.py /usr/local/lib/python3.12/site-packages/hl_app/workers/__init__.py
COPY --chown=10001:10001 backend/hl_app/workers/__init__.py /app/backend/hl_app/workers/__init__.py
